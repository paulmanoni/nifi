package web

import (
	"net/http"
	"net/url"
	"sort"
	"strings"

	"github.com/paulmanoni/nifi/internal/web/ui/button"
	"github.com/paulmanoni/nifi/internal/web/ui/icon"
)

// migrateView is the "Migrate a database" wizard. Each step is a page:
// steps 1 and 2 are GET forms carrying what was chosen (?source=, ?target=,
// ?name=, ?t= per table or ?all=1), step 3 creates the flow through
// POST /api/flows/wizard.
type migrateView struct {
	Step                   int
	Conns                  []conn
	Source, Target         *conn
	SourceID, TargetID     string
	Name                   string
	Tables                 []tableSummary // the source's, step 2
	ListErr                error
	Picked                 map[string]bool // ?t=
	All                    bool            // ?all=1, or nothing picked yet
	Manual                 string          // without the data permission
	Error                  string
}

func migrateRoute(c *ctx) (page, int) {
	if !c.can("edit") {
		return page{Nav: "flows", Title: "Migrate a database", Body: emptyState("shield-x", "No access", "Creating flows needs the edit permission.", c.href("/flows"), "Back to flows")}, http.StatusForbidden
	}
	q := c.r.URL.Query()
	v := migrateView{SourceID: q.Get("source"), TargetID: q.Get("target"), Name: strings.TrimSpace(q.Get("name")), Manual: q.Get("tables"), Picked: map[string]bool{}}
	for _, t := range q["t"] {
		v.Picked[t] = true
	}
	v.All = q.Get("all") != "" || len(v.Picked) == 0
	_ = c.get("/connections", &v.Conns)
	for i := range v.Conns {
		switch v.Conns[i].ID {
		case v.SourceID:
			v.Source = &v.Conns[i]
		}
		if v.Conns[i].ID == v.TargetID {
			v.Target = &v.Conns[i]
		}
	}
	switch q.Get("step") {
	case "2", "3":
		switch {
		case v.Source == nil || v.Target == nil:
			v.Step, v.Error = 1, "Choose a source and a target."
		case v.SourceID == v.TargetID:
			v.Step, v.Error = 1, "The source and the target must differ."
		case v.Target.Driver != "postgres":
			v.Step, v.Error = 1, "The target must be PostgreSQL."
		default:
			v.Step = 2
			if q.Get("step") == "3" {
				v.Step = 3
			}
		}
	default:
		v.Step = 1
	}
	if v.Name == "" && v.Source != nil && v.Target != nil {
		v.Name = v.Source.label() + " → " + v.Target.label()
	}
	if v.Step == 2 && c.can("data") {
		v.ListErr = c.get("/connections/"+url.PathEscape(v.SourceID)+"/tables", &v.Tables)
		sort.Slice(v.Tables, func(i, j int) bool { return v.Tables[i].Name < v.Tables[j].Name })
	}
	return page{Nav: "flows", Title: "Migrate a database", Body: migratePage(c, v)}, http.StatusOK
}

// tables is what step 3 sends: [] for every table.
func (v migrateView) tables(canData bool) []string {
	if !canData {
		return strings.FieldsFunc(v.Manual, func(r rune) bool { return r == ',' || r == ' ' || r == '\n' || r == '\t' || r == '\r' })
	}
	if v.All {
		return []string{}
	}
	out := make([]string, 0, len(v.Picked))
	for t := range v.Picked {
		out = append(out, t)
	}
	sort.Strings(out)
	return out
}

func (v migrateView) tablesSummary(canData bool) string {
	ts := v.tables(canData)
	if len(ts) == 0 {
		return "all tables"
	}
	return plural(len(ts), "table", "tables")
}

func (v migrateView) wizardBody(canData bool) string {
	return jsonAttr(map[string]any{"name": v.Name, "sourceConnectionId": v.SourceID, "targetConnectionId": v.TargetID, "tables": v.tables(canData)})
}

templ migratePage(c *ctx, v migrateView) {
	<div class="mx-auto flex max-w-[860px] flex-col px-6 pt-5 pb-12">
		<div class="mb-4 flex flex-wrap items-center gap-3">
			@button.Button(button.Props{Variant: button.VariantGhost, Size: button.SizeIcon, Href: c.href("/flows"), Attributes: templ.Attributes{"title": "All flows"}}) {
				@icon.Icon("arrow-left", "size-4")
			}
			<h1 class="text-[17px] font-semibold">Migrate a database</h1>
			<span class="flex-1"></span>
			<ol class="flex items-center gap-2 text-[12px]">
				@wizardStep(1, "Connections", v.Step)
				<span class="h-px w-5 bg-border-strong"></span>
				@wizardStep(2, "Tables", v.Step)
				<span class="h-px w-5 bg-border-strong"></span>
				@wizardStep(3, "Options", v.Step)
			</ol>
		</div>
		<div class="rounded-sm border bg-card">
			switch v.Step {
				case 1:
					@migrateConnections(c, v)
				case 2:
					@migrateTables(c, v)
				default:
					@migrateOptions(c, v)
			}
		</div>
	</div>
}

templ wizardStep(n int, label string, cur int) {
	<li class="inline-flex items-center gap-1.5">
		if n < cur {
			<span class="inline-flex size-[18px] items-center justify-center rounded-full bg-ok text-white">
				@icon.Icon("check", "size-3")
			</span>
		} else {
			<span class={ "inline-flex size-[18px] items-center justify-center rounded-full text-[10.5px] font-semibold", templ.KV("bg-primary text-white", n == cur), templ.KV("border border-border-strong text-muted-foreground", n > cur) }>{ itoa(n) }</span>
		}
		<span class={ templ.KV("font-semibold", n == cur), templ.KV("text-muted-foreground", n > cur) }>{ label }</span>
	</li>
}

templ migrateConnections(c *ctx, v migrateView) {
	<form method="get" action={ templ.SafeURL(c.href("/migrate")) } class="flex flex-col">
		<input type="hidden" name="step" value="2"/>
		<div class="flex flex-col gap-4 p-5">
			if len(v.Conns) == 0 {
				<div class="flex flex-col items-center gap-2 py-8 text-center">
					<h3 class="text-[15px] font-semibold">No connections</h3>
					<p class="text-muted-foreground">Create a source and a target connection first.</p>
					@button.Button(button.Props{Variant: button.VariantOutline, Href: c.href("/connections")}) {
						Go to connections
					}
				</div>
			} else {
				<div class="grid grid-cols-[1fr_auto_1fr] items-start gap-3 max-[640px]:grid-cols-1">
					<label class="flex flex-col gap-1">
						<span>
							@fieldLabel("Source connection")
							<span class="text-err">*</span>
						</span>
						<select name="source" required class={ selectClass, "w-full" }>
							<option value="" disabled selected?={ v.SourceID == "" }>Select…</option>
							for _, cn := range v.Conns {
								<option value={ cn.ID } selected?={ cn.ID == v.SourceID }>{ cn.label() } ({ cn.Driver } · { cn.Database })</option>
							}
						</select>
					</label>
					<span class="pt-6 text-muted-foreground max-[640px]:hidden">
						@icon.Icon("arrow-right", "size-4")
					</span>
					<label class="flex flex-col gap-1">
						<span>
							@fieldLabel("Target connection (PostgreSQL)")
							<span class="text-err">*</span>
						</span>
						<select name="target" required class={ selectClass, "w-full" }>
							<option value="" disabled selected?={ v.TargetID == "" }>Select…</option>
							for _, cn := range v.Conns {
								if cn.Driver == "postgres" {
									<option value={ cn.ID } selected?={ cn.ID == v.TargetID }>{ cn.label() } ({ cn.Database })</option>
								}
							}
						</select>
					</label>
				</div>
				if !hasPostgres(v.Conns) {
					<p class="text-[12px] text-warn">No PostgreSQL connections yet — v1 writes to PostgreSQL only.</p>
				}
				<label class="flex max-w-[420px] flex-col gap-1">
					@fieldLabel("Flow name")
					<input name="name" value={ v.Name } placeholder="Database migration" class={ inputClass }/>
					<span class="text-[11px] text-muted-foreground">Defaults to “source → target”.</span>
				</label>
				if v.Error != "" {
					<p class="rounded-sm border border-err/30 bg-err-soft px-2.5 py-1.5 text-[12px] text-err">{ v.Error }</p>
				}
			}
		</div>
		@wizardFooter(c, "", "Next")
	</form>
}

func hasPostgres(cs []conn) bool {
	for _, c := range cs {
		if c.Driver == "postgres" {
			return true
		}
	}
	return false
}

templ wizardFooter(c *ctx, back, next string) {
	<footer class="flex items-center gap-2 border-t px-5 py-3">
		if back != "" {
			@button.Button(button.Props{Variant: button.VariantOutline, Href: back}) {
				Back
			}
		}
		<span class="flex-1"></span>
		@button.Button(button.Props{Variant: button.VariantOutline, Href: c.href("/flows")}) {
			Cancel
		}
		@button.Button(button.Props{Type: button.TypeSubmit}) {
			{ next }
		}
	</footer>
}

func (v migrateView) back(c *ctx, step string) string {
	q := url.Values{"source": {v.SourceID}, "target": {v.TargetID}, "name": {v.Name}}
	if step != "1" {
		q.Set("step", step)
	}
	return c.href("/migrate") + "?" + q.Encode()
}

templ migrateTables(c *ctx, v migrateView) {
	<form method="get" action={ templ.SafeURL(c.href("/migrate")) } class="flex flex-col" data-wizard-tables>
		<input type="hidden" name="step" value="3"/>
		<input type="hidden" name="source" value={ v.SourceID }/>
		<input type="hidden" name="target" value={ v.TargetID }/>
		<input type="hidden" name="name" value={ v.Name }/>
		if !c.can("data") {
			<div class="flex flex-col gap-2 p-5">
				<label class="flex flex-col gap-1">
					@fieldLabel("Tables to migrate")
					<textarea name="tables" rows="6" placeholder="customers, orders, order_items" class={ textareaClass, "font-mono" }>{ v.Manual }</textarea>
				</label>
				<p class="text-[12px] text-muted-foreground">Browsing the source's tables needs the <b>data</b> permission. List table names (comma or newline separated), or leave empty to migrate every table.</p>
			</div>
		} else if v.ListErr != nil {
			<div class="flex flex-col items-center gap-2 p-8 text-center">
				<h3 class="text-[15px] font-semibold">Could not list tables</h3>
				<p class="text-err">{ v.ListErr.Error() }</p>
				@button.Button(button.Props{Variant: button.VariantOutline, Href: c.r.URL.RequestURI()}) {
					Retry
				}
			</div>
		} else {
			<div class="flex flex-wrap items-center gap-2 border-b p-3">
				<label class="relative flex w-[220px] items-center">
					<span class="pointer-events-none absolute left-2 text-muted-foreground">
						@icon.Icon("search", "size-3.5")
					</span>
					<input type="search" data-filter="[data-wizard-tables] tbody" placeholder="Filter tables…" class={ inputClass, "pl-7" }/>
				</label>
				@button.Button(button.Props{Variant: button.VariantOutline, Size: button.SizeSm, Attributes: templ.Attributes{"data-check": "all"}}) {
					Select all
				}
				@button.Button(button.Props{Variant: button.VariantOutline, Size: button.SizeSm, Attributes: templ.Attributes{"data-check": "none"}}) {
					Select none
				}
				<span class="flex-1"></span>
				<span class="text-[12px] text-muted-foreground" data-wizard-count></span>
			</div>
			<div class="max-h-[calc(100vh-360px)] min-h-[200px] overflow-y-auto">
				<table class="w-full text-[12.5px]">
					<thead class="sticky top-0 bg-card">
						<tr class="border-b bg-muted/60 text-left text-[11px] font-semibold tracking-wide text-muted-foreground uppercase">
							<th class="w-8 px-3 py-2"></th>
							<th class="px-3 py-2">Table</th>
							<th class="px-3 py-2 text-right">Est. rows</th>
							<th class="px-3 py-2 text-right">Size</th>
							<th class="w-8 px-3 py-2"></th>
						</tr>
					</thead>
					<tbody>
						for _, t := range v.Tables {
							{{ ref := tableRef(t, v.Source.Driver) }}
							<tr class="border-b last:border-0 hover:bg-muted" data-search={ lower(ref) }>
								<td class="px-3 py-1">
									<input type="checkbox" name="t" value={ ref } checked?={ v.All || v.Picked[ref] } data-rows={ i64(t.EstimatedRows) } data-bytes={ i64(t.SizeBytes) } data-nopk?={ !t.HasPrimaryKey } class="accent-[var(--nf-accent)]"/>
								</td>
								<td class="px-3 py-1 font-mono">
									if ref != t.Name {
										<span class="text-muted-foreground">{ t.Schema }.</span>
									}
									{ t.Name }
								</td>
								<td class="px-3 py-1 text-right tabular-nums">{ fmtCompact(t.EstimatedRows) }</td>
								<td class="px-3 py-1 text-right tabular-nums">{ fmtBytes(t.SizeBytes) }</td>
								<td class="px-3 py-1">
									if !t.HasPrimaryKey {
										<span class="text-warn" title="No primary key: read as one streaming scan — not chunked, not resumable, and merge mode cannot upsert.">
											@icon.Icon("alert-triangle", "size-3.5")
										</span>
									}
								</td>
							</tr>
						}
					</tbody>
				</table>
			</div>
			<p class="hidden border-t px-3 py-2 text-[12px] text-warn" data-wizard-nopk></p>
		}
		@wizardFooter(c, v.back(c, "1"), "Next")
	</form>
}

templ migrateOptions(c *ctx, v migrateView) {
	<form data-json data-action={ c.api("/flows/wizard") } data-method="POST" data-extra={ v.wizardBody(c.can("data")) } data-success="Migration flow created" data-then={ c.href("/flows/{id}") } class="flex flex-col">
		<div class="flex flex-col gap-4 p-5">
			<div class="flex flex-wrap items-center gap-2 rounded-sm border bg-sunken px-3 py-2 text-[12.5px]">
				<b>{ v.Source.label() }</b>
				<span class="text-muted-foreground">({ v.Source.Driver })</span>
				@icon.Icon("arrow-right", "size-3.5")
				<b>{ v.Target.label() }</b>
				<span class="flex-1"></span>
				<span class="text-muted-foreground">{ v.tablesSummary(c.can("data")) }</span>
			</div>
			<label class="flex max-w-[240px] flex-col gap-1">
				@fieldLabel("Target schema")
				<input name="targetSchema" value="public" class={ inputClass, "font-mono" } data-trim data-or="public"/>
			</label>
			<div class="flex flex-col gap-1.5">
				@fieldLabel("Write mode")
				<div class="grid grid-cols-2 gap-2 max-[640px]:grid-cols-1">
					@modeCard("merge", "Merge (upsert)", "COPY into staging, then INSERT … ON CONFLICT DO UPDATE. Idempotent; safe to resume.", true)
					@modeCard("merge_ignore", "Merge, ignore existing", "Like merge but ON CONFLICT DO NOTHING — existing rows win.", false)
					@modeCard("copy", "COPY (fastest)", "Straight COPY. For fresh loads into empty tables; not idempotent.", false)
					@modeCard("insert", "Batched INSERT", "Multi-row INSERT fallback. Slowest.", false)
				</div>
			</div>
			<label class="inline-flex items-center gap-2">
				<input type="checkbox" name="createTables" checked class="accent-[var(--nf-accent)]"/>
				Create missing tables in the target
			</label>
			<div class="group flex flex-col gap-1">
				<label class="inline-flex items-center gap-2">
					<input type="checkbox" name="truncate" class="accent-[var(--nf-accent)]"/>
					Truncate target tables before loading
				</label>
				<p class="hidden pl-6 text-[12px] text-warn group-has-[input:checked]:block">Existing data in the selected target tables will be deleted.</p>
			</div>
		</div>
		@wizardFooter(c, v.back(c, "2"), "Create flow")
	</form>
}

templ modeCard(value, title, desc string, checked bool) {
	<label class="flex cursor-pointer gap-2 rounded-sm border p-2.5 hover:bg-muted has-[:checked]:border-primary has-[:checked]:bg-accent-soft">
		<input type="radio" name="mode" value={ value } checked?={ checked } class="mt-0.5 accent-[var(--nf-accent)]"/>
		<span class="flex flex-col gap-0.5">
			<b class="text-[12.5px]">{ title }</b>
			<span class="text-[11.5px] text-secondary-foreground">{ desc }</span>
		</span>
	</label>
}
